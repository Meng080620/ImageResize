# REMBG_TARGET (build-time, Vite proxy): where the dev/preview server forwards
# /rembg/* requests. Defaults to http://127.0.0.1:7001. Start rembg locally with:
#   pip install "rembg[cli]" onnxruntime   # onnxruntime is a separate dep in rembg 2.x
#   rembg s --port 7001                     # NOTE: port 7000 is taken by macOS AirPlay
#                                           # Receiver — use 7001 (or disable AirPlay).
# Then run the dev server with REMBG_TARGET pointing at that port:
#   REMBG_TARGET="http://127.0.0.1:7001" npm run dev
# REMBG_TARGET="http://127.0.0.1:7001"

# VITE_REMBG_URL (client): override the in-app rembg base. Leave unset to use the
# same-origin /rembg proxy (recommended). Set only to hit a CORS-enabled rembg
# directly, bypassing the proxy.
# VITE_REMBG_URL="/rembg"
